# Copy this file to .env and fill in real values. Never commit .env.
# Get the dev branch connection strings from Anthony (Neon console: jaals-db > dev branch > Connect).

# Pooled connection (host contains "-pooler"): used by the app at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Direct connection (same string without "-pooler"): used by Prisma migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Added once auth is set up (spike 2):
# BETTER_AUTH_SECRET=   # random 32+ bytes, e.g. `openssl rand -base64 32`
# BETTER_AUTH_URL=http://localhost:5173
